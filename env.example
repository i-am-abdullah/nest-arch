# Application Configuration
NODE_ENV=development
PORT=3000

# Master Database Configuration (Port 5432)
# Used for write operations
DB_MASTER_HOST=localhost
DB_MASTER_PORT=5432
DB_MASTER_USER=postgres
DB_MASTER_PASSWORD=postgres
DB_MASTER_NAME=nestarch

# Slave Database Configuration (Port 5433)
# Used for read operations (replica)
DB_SLAVE_HOST=localhost
DB_SLAVE_PORT=5433
DB_SLAVE_USER=postgres
DB_SLAVE_PASSWORD=postgres
DB_SLAVE_NAME=nestarch

# JWT Configuration
# IMPORTANT: Change these secrets in production!
JWT_SECRET=your-secret-key-change-in-production-please-use-strong-random-string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Logging Configuration
# Options: error, warn, info, debug, verbose
LOG_LEVEL=info

# Rate Limiting Configuration
# TTL: Time window in seconds
# LIMIT: Maximum requests per time window
THROTTLER_TTL=60
THROTTLER_LIMIT=100

# Schedule Configuration (Refresh Token Cleanup)
# ENABLED: Enable/disable the cleanup job
# CRON: Cron expression (default: daily at 2 AM UTC)
# BATCH_SIZE: Number of tokens to process per batch
REFRESH_TOKEN_CLEANUP_ENABLED=true
REFRESH_TOKEN_CLEANUP_CRON=0 2 * * *
REFRESH_TOKEN_CLEANUP_BATCH_SIZE=1000
